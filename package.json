{
  "name": "flowpayments",
  "version": "1.0.0",
  "description": "Deterministic offline simulator & verification engine for conditional, milestone-based, and multi-party split payments with double-entry integrity and zero real-fund exposure.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Manoj Rollo <fbxmano@gmail.com> (https://github.com/MRJonam91)",
  "homepage": "https://github.com/MRJonam91/FlowPayments#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MRJonam91/FlowPayments.git"
  },
  "bugs": {
    "url": "https://github.com/MRJonam91/FlowPayments/issues"
  },
  "keywords": [
    "flowpayments",
    "payment-simulator",
    "split-payments",
    "conditional-payments",
    "escrow-simulation",
    "double-entry-bookkeeping",
    "milestone-payments",
    "marketplace-payouts",
    "offline-first",
    "rule-engine",
    "financial-dsl",
    "audit-trail",
    "typescript",
    "safe-math"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "flowpayments": "dist/cli/index.js",
    "flowpay": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.it.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "node src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "trial": "node src/cli/index.ts trial",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/MRJonam91"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/mrjonam"
    },
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/mrjonam"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/manorollo"
    }
  ],
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.7.3"
  }
}
